
{% if s4gtmConfig is defined and s4gtmConfig.operational and s4gtmContainerLoaded|default(false) %}
    {% if s4gtmConfig.tagInBody %}
        {% sw_include '@Storefront/storefront/component/gtm/container-script.html.twig' %}
    {% endif %}

    <noscript>
        <iframe src="{{ s4gtmConfig.gtmOrigin }}/ns.html?id={{ s4gtmConfig.containerId|e('html_attr') }}"
                height="0" width="0" style="display:none;visibility:hidden"
                title="Google Tag Manager"></iframe>
    </noscript>
{% endif %}
